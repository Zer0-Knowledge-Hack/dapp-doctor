# Copy to .env.local and fill in. .env.local is gitignored: never commit it.
# This template holds names only. Never put a value here.

# Nebius Token Factory — AI root-cause analysis (not entered, not wired in)
NEBIUS_API_KEY=
NEBIUS_MODEL=

# RevenueCat — DApp Doctor Pro.
# Public key: the Test Store public API key. Ships to the browser by design.
NEXT_PUBLIC_REVENUECAT_API_KEY=
# Must match the entitlement identifier in the RevenueCat dashboard exactly.
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=daap_doctor_pro
# Secret key (sk_...): server-side entitlement checks. Never reaches the browser.
REVENUECAT_SECRET_API_KEY=

# Upstash Redis — diagnosis history (the paid feature). The Vercel marketplace
# integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
